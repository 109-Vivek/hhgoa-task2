# Sarvam AI API Key (For Speech-to-Text & Sarvam LLM)
SARVAM_API_KEY=your_sarvam_api_key_here

# Groq API Key (Recommended for ultra-fast LLaMA 3.3 70B / 8B - Free Tier)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (Alternative Free Tier)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional Fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Model Configurations
EMBEDDING_MODEL_NAME=BAAI/bge-m3
PRIMARY_LLM_PROVIDER=groq
PRIMARY_LLM_MODEL=llama-3.3-70b-versatile
FALLBACK_LLM_MODEL=llama-3.1-8b-instant

# Pipeline Settings
MAX_RETRIEVAL_RESULTS=5
SIMILARITY_THRESHOLD=0.35
INDEX_DIR=./data/indices
