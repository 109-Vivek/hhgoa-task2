# ==============================================================================
# API Keys (Provide valid keys for live remote provider calls)
# ==============================================================================
# Sarvam AI API Key (For Speech-to-Text: https://sarvam.ai)
SARVAM_API_KEY=

# Google Gemini API Key (Alternative: https://aistudio.google.com)
GEMINI_API_KEY=

# ==============================================================================
# Mock & Fallback Configuration Toggles
# ==============================================================================
# FORCE_STT_MOCK: Set to true to always use simulated STT (offline/benchmark mode)
FORCE_STT_MOCK=false
# ALLOW_STT_FALLBACK: Set to true to fallback to simulated STT if API fails/missing
ALLOW_STT_FALLBACK=false

# FORCE_LLM_MOCK: Set to true to always use local grounded extractive synthesis (<2ms)
FORCE_LLM_MOCK=false
# ALLOW_LLM_FALLBACK: Set to true to fallback to local grounded synthesis if API fails
ALLOW_LLM_FALLBACK=false

# FORCE_SAMPLE_CORPUS: Set to true to use built-in Indic sample passages during indexing
FORCE_SAMPLE_CORPUS=false
# ALLOW_DATASET_FALLBACK: Set to true to fallback to sample corpus if HF stream fails
ALLOW_DATASET_FALLBACK=false

# ==============================================================================
# Model Configurations
# ==============================================================================
EMBEDDING_MODEL_NAME=BAAI/bge-m3
PRIMARY_LLM_PROVIDER=gemini
PRIMARY_LLM_MODEL=gemini-3.6-flash
FALLBACK_LLM_MODEL=gemini-3-flash

# ==============================================================================
# Pipeline & Retrieval Settings
# ==============================================================================
MAX_RETRIEVAL_RESULTS=5
SIMILARITY_THRESHOLD=0.35
INDEX_DIR=./data/indices



# Hugging Face Configs
HF_TOKEN=
